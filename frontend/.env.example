# ==============================================================================
# AR-DINE Frontend Environment Configuration (.env.example)
# Copy this file to .env.local for local development:
#   Copy-Item .env.example .env.local
# ==============================================================================

# Public API Base URL pointing to the NestJS backend API (/api/v1)
# Note: Keep all sensitive secrets on the backend. Only public variables should use NEXT_PUBLIC_
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
