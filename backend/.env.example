# ==============================================================================
# AR-DINE Backend Environment Configuration (.env.example)
# Copy this file to .env for local development:
#   Copy-Item .env.example .env
# ==============================================================================

# Server Environment (development | production | test)
NODE_ENV=development

# HTTP Server Port
PORT=4000

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection String
# Leave blank to run the API in unconfigured scaffolding mode (health check will report database: unconfigured).
# For full multi-tenant database features and seed script, provide your MongoDB Atlas cluster URI:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ar_dine?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Session Security (Phase 3)
# In production, secrets MUST be at least 32 characters long.
# Generate secure random secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ar-dine-api
# Media & 3D Model Storage (Phase 4 & Phase 10)
# Provider options: 'local' (disk storage with static serving) or 'cloudinary' (external cloud storage)
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Canonical Public Frontend Base URL (Phase 5)
# Used by QrService to generate physical tabletop QR codes.
# In production, this MUST point to the canonical public HTTPS frontend domain:
# Example: https://ar-dine.yourdomain.com
FRONTEND_BASE_URL=http://localhost:3000

# Optional: External Cloudinary integration for cloud delivery (Phase 10)
# To enable, set STORAGE_PROVIDER=cloudinary and supply valid Cloudinary credentials:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

