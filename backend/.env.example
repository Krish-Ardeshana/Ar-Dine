# ==============================================================================
# AR-DINE Backend Environment Configuration (.env.example)
# Copy this file to .env for local development:
#   Copy-Item .env.example .env
# ==============================================================================

# Server Environment (development | production | test)
NODE_ENV=development

# HTTP Server Port
PORT=4000

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection String
# Leave blank to run the API in unconfigured scaffolding mode (health check will report database: unconfigured).
# For full multi-tenant database features and seed script, provide your MongoDB Atlas cluster URI:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ar_dine?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Session Security (Phase 3)
# In production, secrets MUST be at least 32 characters long.
# Generate secure random secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ar-dine-api
JWT_AUDIENCE=ar-dine-app

