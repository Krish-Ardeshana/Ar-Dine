# ==============================================================================
# AR-DINE Backend Environment Configuration (.env.example)
# Copy this file to .env for local development:
#   Copy-Item .env.example .env
# ==============================================================================

# Server Environment (development | production | test)
NODE_ENV=development

# HTTP Server Port
PORT=4000

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Database Connection (MongoDB Atlas connection string - Optional for Phase 1 scaffolding)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ar_dine?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secret (JWT signing secret - Required in Phase 3)
JWT_SECRET=
